# ==============================================================================
# ClockIt — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local overrides.
# In production (e.g. Vercel), set these in the dashboard project settings.
#
# SECURITY RULES:
# 1. NEVER commit actual credentials or secrets to version control.
# 2. ONLY use the public anon/publishable key with the VITE_ prefix.
# 3. NEVER provide or expose SUPABASE_SERVICE_ROLE_KEY in client applications.
# ==============================================================================

# Supabase API URL (Project Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable Anon Key (Project Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token-placeholder
